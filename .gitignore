# Dependencies and build output
node_modules/
dist/
apps/*/dist/
coverage/
**/coverage/
apps/docs/build/
.docusaurus/
.cache/
.pnpm-store/
aws/dist/
apps/mobile-app/public/_expo/
apps/web-app/.next/
apps/web-app/.next-dev-all-*/
apps/web-app/.next-dev-all-runtime-*/
apps/web-app/.vercel/
apps/web-app/out/
lambda-deployment.zip

# Remotion video studio: rendered output and raw screen recordings are
# large binaries that don't belong in git — keep only the folder structure.
apps/video-studio/out/
apps/video-studio/public/recordings/**
!apps/video-studio/public/recordings/**/
!apps/video-studio/public/recordings/**/.gitkeep
# Playwright storage-state files capture live session cookies/tokens for
# recording authenticated flows (dashboard, speakers, meetings) — never commit.
apps/video-studio/.recording-state/
package-lock.json

# Expo
.expo/
web-build/
expo-env.d.ts
sst-env.d.ts

