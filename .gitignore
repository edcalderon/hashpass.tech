!**/.env.example
config/private-gcloud.json
config/hashpass-eas.json
infrastructure/terraform/gcp/gcp-credentials.json
infrastructure/terraform/stacks/gcp/directus.*.env
!infrastructure/terraform/stacks/gcp/directus.*.env.example
packages/infra/terraform/gcp/gcp-credentials.json
packages/infra/terraform/stacks/gcp/directus.*.env
