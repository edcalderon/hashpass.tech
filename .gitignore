apps/web-app/out/
lambda-deployment.zip
hashpass-links-api-lambda.zip
packages/infra/lambda/autodiscover/autodiscover-lambda.zip

# Remotion video studio: rendered output and raw screen recordings are
# large binaries that don't belong in git — keep only the folder structure.
apps/video-studio/out/
apps/video-studio/public/event-heroes/
apps/video-studio/public/recordings/**
!apps/video-studio/public/recordings/**/
!apps/video-studio/public/recordings/**/.gitkeep
# Playwright storage-state files capture live session cookies/tokens for
# recording authenticated flows (dashboard, speakers, meetings) — never commit.
apps/video-studio/.recording-state/
package-lock.json
!packages/infra/lambda/package-lock.json
!packages/plane-mcp-gateway/package-lock.json

# Expo
.expo/
web-build/
expo-env.d.ts
sst-env.d.ts

# Local Claude Code tool config
.claude/

# Terraform and IaC local state
*.tfvars
!terraform.tfvars.example
*.tfstate
*.tfstate.*
# terraform plan files embed resolved variable values (including sensitive
# ones from *.tfvars) in binary form -- never commit these.
tfplan
*.tfplan
.terraform/

