# Dependencies and build output
node_modules/
dist/
dist-lambda/
apps/*/dist/
coverage/
**/coverage/
apps/docs/build/
.docusaurus/
.cache/
.pnpm-store/
aws/dist/
apps/mobile-app/public/_expo/
apps/web-app/.next/
apps/web-app/.next-dev-all-*/
apps/web-app/.next-dev-all-runtime-*/
