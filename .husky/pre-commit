#!/usr/bin/env sh
set -e

versioning_available=0
if pnpm -s exec versioning --help >/dev/null 2>&1; then
  versioning_available=1
fi

echo "🔐 Running secret scan..."
secret_scan_ran=0
if [ "$versioning_available" -eq 1 ]; then
  pnpm -s exec versioning check-secrets
  secret_scan_ran=1
else
  echo "⚠️  Versioning tool not found; skipping repo-specific secret patterns."
fi

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --redact --no-banner
  secret_scan_ran=1
else
  echo "⚠️  Gitleaks not found; install it locally to enable the staged generic secret scan."
fi

if [ "$secret_scan_ran" -eq 0 ]; then
  echo "❌ No secret scan tool found. Install 'versioning' or 'gitleaks' and retry."
  exit 1
fi

# A manifest change without its lockfile passes every local check and then fails every CI job at the install
# step (ERR_PNPM_OUTDATED_LOCKFILE), so catch it here. Skips itself when no manifest or lockfile is staged.
node packages/tools/scripts/check-lockfiles.mjs --staged

echo "📐 Checking type placement on staged changes..."
TYPE_PLACEMENT_STAGED=1 pnpm -s run check:type-placement

# The staged check catches declarations added by this commit. A second
# branch-range check catches declarations that landed in an earlier commit and
# would otherwise only be discovered by the pull-request workflow.
type_placement_base="${TYPE_PLACEMENT_BASE:-}"
if [ -z "$type_placement_base" ] && git rev-parse --verify origin/main >/dev/null 2>&1; then
  type_placement_base="origin/main"
fi
if [ -z "$type_placement_base" ]; then
  type_placement_base="$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
fi
if [ -n "$type_placement_base" ]; then
  echo "📐 Checking type placement across the branch range ($type_placement_base)..."
  TYPE_PLACEMENT_BASE="$type_placement_base" pnpm -s run check:type-placement
else
  echo "❌ No remote base ref is available for the branch-wide type placement check."
  echo "   Fetch origin/main or set TYPE_PLACEMENT_BASE before committing."
  exit 1
fi

echo "📘 Checking README sync..."
echo "🌐 Checking dashboard translations (en/es/ko)..."
pnpm --dir apps/mobile-app run check:dashboard-translations

if [ "$versioning_available" -eq 1 ]; then
  pnpm -s run readme:check
else
  echo "❌ Versioning tool not found. Run pnpm install and retry."
  exit 1
fi

echo "🧪 Skipping test suite due to jest config..."
# npm test -- --watchAll=false

echo "🔒 Running version validation..."
if [ "$versioning_available" -eq 1 ]; then
  pnpm -s exec versioning validate
else
  echo "❌ Versioning tool not found. Run pnpm install and retry."
  exit 1
fi
