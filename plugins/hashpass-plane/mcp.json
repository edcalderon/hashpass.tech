{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "hashpass-plane": {
      "type": "streamable-http",
      "url": "https://mcp.hashpass.tech/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://mcp.hashpass.tech/mcp",
            "baseScopes": [
              "openid",
              "profile",
              "email",
              "offline_access",
              "plane:read",
              "plane:write"
            ]
          }
        }
      }
    }
  }
}
