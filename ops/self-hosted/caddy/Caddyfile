{
  email {$ACME_EMAIL}
  admin off
  log default {
    output stdout
    format json
  }
}

(common_security) {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
}

{$PLANE_DOMAIN:plane.example.invalid} {
  import common_security

  # Private status page, generated from the same source as the Plane command-center page and written to the
  # read-only /srv/status mount by .github/workflows/status-page-publish.yml. Visitors sign in with a HASHPASS
  # account through the gateway's status gate; only approved email domains pass. Everything else stays Plane.
  @statusFlow path /status/login /status/callback /status/logout
  handle @statusFlow {
    reverse_proxy plane-mcp-gateway:8220
  }

  @statusMetrics path /status/metrics
  handle @statusMetrics {
    reverse_proxy plane-mcp-gateway:8220
  }

  @statusAsset path /status/status-page.js /status/status-version.json
  handle @statusAsset {
    forward_auth plane-mcp-gateway:8220 {
      uri /status-gate/verify
    }
    root * /srv/status
    uri strip_prefix /status
    header Cache-Control "no-store"
    header X-Robots-Tag "noindex"
    file_server
  }

  @status path /status /status/
  handle @status {
    # An unauthenticated or unapproved visitor never reaches file_server: the gate's 302 is returned instead.
    forward_auth plane-mcp-gateway:8220 {
      uri /status-gate/verify
    }
    root * /srv/status
    rewrite * /index.html
    header Cache-Control "no-store"
    header X-Robots-Tag "noindex"
    header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    file_server
  }

  handle {
    reverse_proxy proxy:80
  }
}

{$HELPDESK_DOMAIN:support.example.invalid} {
  import common_security
  reverse_proxy frappe-frontend:8080
}

{$MCP_DOMAIN:mcp.example.invalid} {
  import common_security
  reverse_proxy plane-mcp-gateway:8220 {
    flush_interval -1
  }
}
