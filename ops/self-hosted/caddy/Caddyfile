{
  email {$ACME_EMAIL}
  admin off
  log default {
    output stdout
    format json
  }
}

(common_security) {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
}

{$PLANE_DOMAIN:plane.example.invalid} {
  import common_security

  # Public status page, generated from the same source as the Plane command-center page and written to the
  # read-only /srv/status mount by .github/workflows/status-page-publish.yml. Everything else stays Plane.
  @status path /status /status/
  handle @status {
    root * /srv/status
    rewrite * /index.html
    header Cache-Control "no-cache"
    header X-Robots-Tag "noindex"
    file_server
  }

  handle {
    reverse_proxy proxy:80
  }
}

{$HELPDESK_DOMAIN:support.example.invalid} {
  import common_security
  reverse_proxy frappe-frontend:8080
}

{$MCP_DOMAIN:mcp.example.invalid} {
  import common_security
  reverse_proxy plane-mcp-gateway:8220 {
    flush_interval -1
  }
}
