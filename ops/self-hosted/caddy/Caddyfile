{
  email {$ACME_EMAIL}
  admin off
  log default {
    output stdout
    format json
  }
}

(common_security) {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
}

{$PLANE_DOMAIN:work.hashpass.tech} {
  import common_security
  reverse_proxy proxy:80
}

{$HELPDESK_DOMAIN:support.hashpass.tech} {
  import common_security
  reverse_proxy frappe-frontend:8080
}
