# Public endpoints
ACME_EMAIL=ops@example.invalid
PLANE_DOMAIN=plane.example.invalid
HELPDESK_DOMAIN=support.example.invalid
# Optional Caddy certificate/DNS-provider settings. Keep provider credentials
# in the private runtime environment, never in this template.
CERT_EMAIL=
CERT_ACME_CA=
CERT_ACME_DNS=

# Plane CE v1.4.2 (generate every secret independently)
PLANE_VERSION=v1.4.2
APP_DOMAIN=plane.example.invalid
WEB_URL=https://plane.example.invalid
CORS_ALLOWED_ORIGINS=https://plane.example.invalid
POSTGRES_USER=plane
POSTGRES_DB=plane
POSTGRES_PASSWORD=YOUR_generated-secret
DATABASE_URL=postgresql://plane:YOUR_url-encoded-secret@plane-db/plane
SECRET_KEY=YOUR_generated-64-char-secret
LIVE_SERVER_SECRET_KEY=YOUR_generated-secret
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=YOUR_generated-secret
RABBITMQ_VHOST=plane
AMQP_URL=amqp://plane:YOUR_url-encoded-secret@plane-mq:5672/plane
# S3-compatible local Plane/MinIO credentials, not AWS IAM access keys.
# Existing installations may temporarily use the legacy AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY names while migrating this private runtime file.
OBJECT_STORAGE_ACCESS_KEY_ID=YOUR_minio-service-user
OBJECT_STORAGE_SECRET_ACCESS_KEY=YOUR_generated-secret
AWS_S3_BUCKET_NAME=uploads
SITE_ADDRESS=:80

# Frappe Helpdesk v1.30.1
FRAPPE_IMAGE=ghcr.io/frappe/helpdesk:v1.30.1
FRAPPE_SITE_NAME=support.example.invalid
FRAPPE_DB_ROOT_PASSWORD=YOUR_generated-secret
FRAPPE_ADMIN_PASSWORD=YOUR_generated-secret

# Backups: an absolute host path mounted by restic, and an off-server repository.
BACKUP_RETENTION_DAYS=14
RESTIC_REPOSITORY=s3:s3.example.invalid/hashpass-ops
RESTIC_PASSWORD=YOUR_generated-secret
# S3-compatible backup service credentials, not AWS IAM access keys.
# The legacy AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY names are accepted
# during migration, but dedicated backup-only credentials are preferred.
BACKUP_S3_ACCESS_KEY_ID=YOUR_backup-only-key
BACKUP_S3_SECRET_ACCESS_KEY=YOUR_generated-secret

# MCP service users; never use Administrator credentials.
PLANE_API_KEY=YOUR_plane-service-user-key
FRAPPE_MCP_READ_API_KEY=YOUR_read-service-user-key
FRAPPE_MCP_READ_API_SECRET=YOUR_read-service-user-secret
FRAPPE_MCP_WRITE_API_KEY=YOUR_write-service-user-key
FRAPPE_MCP_WRITE_API_SECRET=YOUR_write-service-user-secret
FRAPPE_BASE_URL=https://support.example.invalid
FRAPPE_MCP_ALLOW_WRITES=false
