# Remove legacy-peer-deps to ensure proper dependency resolution
legacy-peer-deps=true
node-linker=hoisted

# Only affects plain-semver-range deps (e.g. @hashpass-tech/sdk's "^0.1.0" in
# apps/mobile-app, apps/web-app) -- explicit "workspace:*"/"workspace:^"
# protocol deps (every other internal @hashpass/* package) are unaffected
# and keep linking to local workspace source regardless of this setting.
# Without this, pnpm silently prefers the local workspace copy even when a
# consumer asks for the real published npm version by plain semver range.
link-workspace-packages=false
