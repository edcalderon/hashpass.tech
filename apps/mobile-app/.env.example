# Required for Supabase Auth
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Frontend origin used by auth redirects.
# Set this to your dev site or tunnel URL for local passwordless testing.
EXPO_PUBLIC_FRONTEND_URL=
FRONTEND_URL=

# EAS project link for Android/iOS build and submission flows.
EAS_PROJECT_ID=
EAS_PROJECT_ID_DEV=

# Optional tenant-specific Supabase profiles.
# These avoid duplicate generic keys when one branch serves multiple tenants.
EXPO_PUBLIC_SUPABASE_PROFILE=core-development
SUPABASE_PROFILE=core-development
EXPO_PUBLIC_BSL_SUPABASE_URL_DEV=
EXPO_PUBLIC_BSL_SUPABASE_KEY_DEV=
BSL_SUPABASE_SERVICE_ROLE_KEY_DEV=
BSL_SUPABASE_DB_URL_DEV=
EXPO_PUBLIC_BSL_SUPABASE_URL_PROD=
EXPO_PUBLIC_BSL_SUPABASE_KEY_PROD=
BSL_SUPABASE_SERVICE_ROLE_KEY_PROD=
BSL_SUPABASE_DB_URL_PROD=

# Event tenant filtering.
# Leave blank in production so the hostname is authoritative:
# - hashpass.tech => main/global explorer
# - bsl.hashpass.tech and bsl-dev.hashpass.tech => BSL event family
# For local testing, set EXPO_PUBLIC_EVENT_TENANT=main, bsl, or bsl2025.
# For exact local/custom filtering, set EXPO_PUBLIC_EVENT_IDS=bsl,bsl2025.
EXPO_PUBLIC_EVENT_TENANT=
EXPO_PUBLIC_EVENT_IDS=

# Local-only global-catalog verification. Demo tenants remain hidden unless
# this is explicitly enabled. Expo requires the EXPO_PUBLIC_ alias in client
# bundles; SHOW_DEMO_EVENTS is accepted by server/test environments.
SHOW_DEMO_EVENTS=false
EXPO_PUBLIC_SHOW_DEMO_EVENTS=false

# Better Auth social login.
# Web Google sign-in uses the shared API-hosted /auth route for every tenant.
EXPO_PUBLIC_BETTER_AUTH_URL=https://api-dev.hashpass.tech/api/auth
EXPO_PUBLIC_BETTER_AUTH_BASE_PATH=/api/auth
BETTER_AUTH_URL=https://api-dev.hashpass.tech/api/auth
BETTER_AUTH_BASE_PATH=/api/auth
BETTER_AUTH_SECRET=
BETTER_AUTH_DATABASE_URL=
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081,https://hashpass.tech,https://www.hashpass.tech,https://hashpass.co,https://www.hashpass.co,https://bsl.hashpass.tech,https://bsl-dev.hashpass.tech,https://bsl2025.hashpass.tech,https://bsl2025.hashpass.co,https://blockchainsummit.hashpass.lat,https://blockchainsummit-dev.hashpass.lat,https://api.hashpass.tech,https://api-dev.hashpass.tech
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=

# Auth provider selection. EXPO_PUBLIC_ prefix is required so Metro inlines it
# into the React Native JS bundle; AUTH_PROVIDER (no prefix) works only server-side.
# Leave these unset to let the runtime infer the provider from the host.
# Values: directus | supabase | better-auth
EXPO_PUBLIC_AUTH_PROVIDER=
AUTH_PROVIDER=

# Required for Directus SSO
DIRECTUS_URL=https://sso.hashpass.co
EXPO_PUBLIC_DIRECTUS_URL=https://sso.hashpass.co
# Optional API base for OAuth proxy and version checks.
# Local development: http://localhost:8081/api
EXPO_PUBLIC_API_BASE_URL=
DIRECTUS_OAUTH_SUPABASE_SYNC_ENABLED=true
DIRECTUS_OAUTH_SUPABASE_BRIDGE_ENABLED=true
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Native Google Sign-In SDK (iOS/Android — system account picker)
# Defaults to true on native builds so Google uses the SDK account-picker flow.
# Set to false only for temporary local diagnostics.
EXPO_PUBLIC_NATIVE_GOOGLE_SIGNIN=true
# Web Client ID from Google Cloud Console (type=Web, NOT Android).
# Required when EXPO_PUBLIC_NATIVE_GOOGLE_SIGNIN=true.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Sentry crash/error reporting (React Native SDK). DSN is a publishable client
# key, safe to ship in the bundle — it is not a secret. SENTRY_AUTH_TOKEN
# (server-side only, never EXPO_PUBLIC_) is required at build time for source
# map / debug symbol upload; without it the release build's stack traces will
# be minified/unsymbolicated in Sentry.
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Required for OTP Emails (Nodemailer)
NODEMAILER_HOST=
NODEMAILER_PORT=587
NODEMAILER_USER=
NODEMAILER_PASS=
NODEMAILER_FROM=info@hashpass.tech

# Optional secondary sender (no-reply@hashpass.info), used only by
# sendWelcomeEmail (lib/email.ts). Runs side by side with NODEMAILER_* above,
# not a replacement for it -- both stay independently configured. Set these
# locally for dev; on deployed environments these are intentionally NOT raw
# Lambda env vars (see INFISICAL_* below) and are fetched from Infisical at
# runtime instead, so leave them unset in .env.production/.env.dev.
NODEMAILER_HOST_INFO=
NODEMAILER_PORT_INFO=587
NODEMAILER_USER_INFO=
NODEMAILER_PASS_INFO=
NODEMAILER_FROM_INFO=no-reply@hashpass.info

# Hybrid secrets policy: vital secrets (DB URLs, service-role keys, OAuth
# secrets, ...) stay as raw Lambda env vars as before. New/non-critical
# secrets go into Infisical instead (self-hosted at secrets.cig.technology)
# and get fetched at runtime via lib/server/infisical-secrets.ts, to stay
# within Lambda's 4KB environment variable limit. Set these 4 locally for
# dev convenience only -- on deployed Lambdas these are NOT env vars either
# (both were already at/over the 4KB ceiling before adding anything); the
# same Universal Auth machine identity credentials instead live in AWS
# Secrets Manager (hashpass/expo-router-api-<env>/infisical-bootstrap),
# fetched via the Lambda's own IAM role.
INFISICAL_DOMAIN=https://secrets.cig.technology
INFISICAL_PROJECT_ID=
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=

# Required for OTP SMS (Brevo)
BREVO_API_KEY=
BREVO_SMS_SENDER=HASHPASS

# Dev-only auth-guard bypass for local debugging of screens behind the login
# requirement (e.g. reproducing native rendering issues without a working
# OTP/magic-link session). Set to 'true' only in your own gitignored
# .env.local — never commit it set to true. Inert in any release/production
# build regardless of this value (also gated by __DEV__ in
# lib/auth/dev-bypass.ts). Leaves `user` null; screens/effects that assume a
# real user object will still behave accordingly.
EXPO_PUBLIC_DEV_AUTH_BYPASS=

# HashPass Auth (QR login for hashpass.club) -- see
# packages/hashpass-links-api/README.md. No stable default yet
# (hashpass.link DNS/infra pending); scanning a HashPass Auth QR code is a
# no-op until this points at a real deployment.
EXPO_PUBLIC_LINKS_API_BASE_URL=
EXPO_PUBLIC_HASHPASS_APP_ID=hashpass-mobile-app
