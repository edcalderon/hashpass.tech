default_platform(:android)

FASTLANE_TRACKS = %w[internal alpha beta production].freeze
GOOGLE_PLAY_JSON_KEY = ENV.fetch(
  'GOOGLE_PLAY_JSON_KEY',
  File.expand_path('../../../config/hashpass-eas.json', __dir__),
).freeze
PACKAGE_NAME = 'com.hashpass.tech'.freeze

def env_value(*names)
  names.each do |name|
    value = ENV[name]
    next if value.nil?

    stripped = value.to_s.strip
    return stripped unless stripped.empty?
  end

  nil
end

def resolve_android_signing_properties
  store_file = env_value('ANDROID_KEYSTORE_PATH', 'ANDROID_RELEASE_KEYSTORE_PATH')
  store_password = env_value('ANDROID_KEYSTORE_PASSWORD', 'ANDROID_RELEASE_KEYSTORE_PASSWORD')
  key_alias = env_value('ANDROID_KEY_ALIAS', 'ANDROID_RELEASE_KEY_ALIAS')
  key_password = env_value('ANDROID_KEY_PASSWORD', 'ANDROID_RELEASE_KEY_PASSWORD')

  missing = []
  missing << 'ANDROID_KEYSTORE_PATH' unless store_file
  missing << 'ANDROID_KEYSTORE_PASSWORD' unless store_password
  missing << 'ANDROID_KEY_ALIAS' unless key_alias
  missing << 'ANDROID_KEY_PASSWORD' unless key_password

  unless missing.empty?
    UI.user_error!(
      "Missing Android signing secrets for fastlane release: #{missing.join(', ')}. " +
      'Set them in the GitHub Actions workflow or export them locally before building.',
    )
  end

  unless File.exist?(store_file)
    UI.user_error!("Android keystore file not found: #{store_file}")
  end

  {
    'android.injected.signing.store.file' => store_file,
    'android.injected.signing.store.password' => store_password,
    'android.injected.signing.key.alias' => key_alias,
    'android.injected.signing.key.password' => key_password,
  }
end

def normalize_track(value)
  track = value.to_s.strip.downcase

  return 'internal' if track.empty?

  unless FASTLANE_TRACKS.include?(track)
    UI.user_error!("Unsupported Google Play track: #{value}")
  end

  track
end

def build_android_bundle
  gradle(
    task: 'bundle',
    build_type: 'Release',
    project_dir: 'android',
    properties: resolve_android_signing_properties,
    print_command: false,
    print_command_output: true
  )

  lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]
end

def find_deobfuscation_files
  patterns = [
    File.join('android', '**', 'outputs', 'mapping', '**', 'mapping.txt'),
    File.join('android', '**', 'outputs', 'native-debug-symbols', '**', 'native-debug-symbols.zip'),
  ]

  patterns
    .flat_map { |pattern| Dir.glob(pattern) }
    .select { |file| File.file?(file) }
    .uniq
    .sort
end

platform :android do
  desc 'Build the Android App Bundle without uploading it.'
  lane :build do |_options|
    build_android_bundle
  end

  desc 'Build the Android App Bundle and upload it to Google Play.'
  lane :release do |options|
    track = normalize_track(options[:track] || ENV['FASTLANE_TRACK'])
    release_status = (options[:release_status] || ENV['FASTLANE_RELEASE_STATUS'] || 'completed').to_s
    aab_path = build_android_bundle
    deobfuscation_files = find_deobfuscation_files

    if deobfuscation_files.any?
      UI.message("Uploading deobfuscation files: #{deobfuscation_files.join(', ')}")
    else
      UI.important(
        'No mapping.txt or native-debug-symbols.zip file was found under Android build outputs. ' +
        'Play Console will keep the deobfuscation warning for this release.',
      )
    end

    upload_options = {
      aab: aab_path,
      track: track,
      release_status: release_status,
      package_name: PACKAGE_NAME,
      json_key: GOOGLE_PLAY_JSON_KEY,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
    }

    upload_options[:mapping_paths] = deobfuscation_files if deobfuscation_files.any?

    upload_to_play_store(**upload_options)
  end

  desc 'Promote an existing Play release from one track to another without uploading a new bundle.'
  lane :promote do |options|
    track = normalize_track(options[:track] || ENV['FASTLANE_TRACK'])
    promote_to = normalize_track(
      options[:track_promote_to] || ENV['FASTLANE_TRACK_PROMOTE_TO']
    )
    release_status = (
      options[:track_promote_release_status] ||
      ENV['FASTLANE_RELEASE_STATUS'] ||
      'completed'
    ).to_s

    upload_to_play_store(
      track: track,
      track_promote_to: promote_to,
      track_promote_release_status: release_status,
      package_name: PACKAGE_NAME,
      json_key: GOOGLE_PLAY_JSON_KEY,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
    )
  end
end

APP_STORE_BUNDLE_ID = 'tech.hashpass.app'.freeze

def app_store_connect_api_key_from_env
  app_store_connect_api_key(
    key_id: ENV.fetch('APP_STORE_CONNECT_KEY_ID'),
    issuer_id: ENV.fetch('APP_STORE_CONNECT_ISSUER_ID'),
    key_content: ENV.fetch('APP_STORE_CONNECT_API_KEY_P8'),
    is_key_content_base64: false,
  )
end

def ios_workspace
  workspace = Dir.glob(File.join('ios', '*.xcworkspace')).sort.first
  UI.user_error!('No iOS workspace found. Run Expo prebuild before Fastlane.') unless workspace

  workspace
end

def sync_ios_signing(readonly:)
  match(
    type: 'appstore',
    app_identifier: APP_STORE_BUNDLE_ID,
    api_key: app_store_connect_api_key_from_env,
    readonly: readonly,
  )
end

def build_ios_ipa
  sync_ios_signing(readonly: ENV.fetch('MATCH_READONLY', 'true') == 'true')

  build_app(
    workspace: ios_workspace,
    scheme: ENV.fetch('IOS_SCHEME', 'HASHPASS'),
    export_method: 'app-store',
    output_directory: File.join('build', 'ios'),
    output_name: 'HASHPASS.ipa',
    clean: true,
  )
end

platform :ios do
  desc 'Build a signed iOS IPA without uploading it.'
  lane :build do |_options|
    build_ios_ipa
  end

  desc 'Build a signed iOS IPA and upload it to internal TestFlight.'
  lane :testflight do |_options|
    ipa_path = build_ios_ipa

    upload_to_testflight(
      api_key: app_store_connect_api_key_from_env,
      ipa: ipa_path,
      distribute_external: false,
      skip_waiting_for_build_processing: false,
    )
  end

  desc 'Create and encrypt App Store signing assets in Match without building an IPA.'
  lane :bootstrap_signing do |_options|
    sync_ios_signing(readonly: false)
  end
end
