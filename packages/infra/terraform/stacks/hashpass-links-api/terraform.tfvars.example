# HashPass Links API stack -- Lambda + API Gateway backing HashPass Auth
# (QR login). See packages/hashpass-links-api/README.md.
aws_region = "us-east-1"

name_prefix = "hashpass-links"

# Build the Lambda ZIP before apply:
#   ./packages/tools/scripts/package-hashpass-links-lambda.sh
lambda_zip_path         = "../../../../../hashpass-links-api-lambda.zip"
lambda_source_code_hash = null
qr_link_expiry_sweep_schedule = "rate(5 minutes)"

# hashpass.link's hosted zone is confirmed live and authoritative -- safe
# to apply. This creates the ACM cert, custom domain mapping, and Route53
# alias records for dev.hashpass.link / hashpass.link.
enable_custom_domain = true

domain_name = {
  dev  = "dev.hashpass.link"
  prod = "hashpass.link"
}
route53_zone_name = "hashpass.link"

# hpass.id (primary short-link/QR domain) and hashp.link (defensive alias)
# both map onto the SAME prod API as hashpass.link above, via the additive
# aws_apigatewayv2_extra_domain module -- see those variables' comments in
# variables.tf. Leave both false until each domain's Spaceship NS cutover to
# the hashpass-dns stack's zones has propagated, then flip independently.
enable_hpass_id_domain   = false
enable_hashp_link_domain = false

# Real values belong in a gitignored *.auto.tfvars or CI secret, never here.
supabase_urls = {
  dev  = ""
  prod = ""
}
supabase_service_role_keys = {
  dev  = ""
  prod = ""
}

cors_allow_origins = {
  dev = [
    "http://localhost:3000",
    "https://hashpass.club",
  ]
  prod = [
    "https://hashpass.club",
    # The approval UI is served from this origin after the Club opens it.
    "https://hashpass.tech",
    "https://www.hashpass.tech",
  ]
}

tags = {
  Environment = "target"
  Project     = "hashpass-links-api"
}
