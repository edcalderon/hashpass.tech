# HashPass web site target-account pipeline

aws_region   = "us-east-2"
name_prefix  = "hashpass"
environment  = "production"
repository   = "hashpass-tech/hashpass.tech"
branch_name  = "main"

# Create the connection with:
#   TARGET_AWS_ACCOUNT_ID=952191196420 \
#   AWS_REGION=us-east-2 \
#   packages/tools/scripts/provision-infra-connection.sh
connection_arn = "arn:aws:codeconnections:us-east-2:123456789012:connection/example"

# Production web build inputs. These are public values but should stay outside git.
# FIXED 2026-08-16: this example previously showed BSL's project
# (mnnqryrdlhddorqsrtbn) here -- core-production is fxgftanraszjjyeidvia.
# Whoever originally provisioned hashpass-prod-site-build's live CodeBuild
# environment variables via `terraform apply` almost certainly copied this
# exact wrong value verbatim: the live project had BSL's URL/key baked in
# under EXPO_PUBLIC_SUPABASE_URL/_PROD until fixed directly via
# `aws codebuild update-project` the same day (see
# apps/docs/docs/infra/supabase-project-map.md). This example must stay
# correct so a future terraform apply of this stack doesn't reintroduce it.
supabase_url      = "https://fxgftanraszjjyeidvia.supabase.co"
supabase_key      = "<EXPO_PUBLIC_SUPABASE_KEY_PROD>"
google_client_id  = "<GOOGLE_CLIENT_ID>"
ga_measurement_id = "G-BY2BLQFHC9"
sentry_dsn        = "<SENTRY_DSN>"

# HashPass Auth (QR login) / HashPass Links. Was missing entirely until
# 2026-08-17 -- fixed directly via `aws codebuild update-project` first
# (hashpass-prod-site-build/hashpass-dev-site-build), same day this stack's
# .tf gained the variables. This example must stay correct so a future
# terraform apply doesn't reintroduce the empty-string default.
links_api_base_url = "https://hpass.id"

# Development web build inputs. core-development and bsl-development
# intentionally share one dev project (gsugeqozyeokncpbndna) -- see
# apps/docs/docs/infra/supabase-project-map.md. FIXED 2026-08-16: this
# previously showed core-production's project (fxgftanraszjjyeidvia), which
# is wrong for a dev build for the same reason as the prod value above --
# same live-drift incident, same day.
supabase_url_dev = "https://gsugeqozyeokncpbndna.supabase.co"
supabase_key_dev = "<EXPO_PUBLIC_SUPABASE_KEY_DEV>"

links_api_base_url_dev = "https://dev.hashpass.link"

build_action_provider_name = "hashpass-ec2-build"
production_build_action_provider_name = "hashpass-prod-ec2-build"
development_build_action_provider_name = "hashpass-dev-ec2-build"
production_build_execution_mode        = "codebuild"
development_build_execution_mode       = "codebuild"
development_codebuild_project_name     = "hashpass-dev-site-build"
build_action_version       = "2"
build_action_timeout       = 60
build_script_path          = "packages/tools/scripts/build-static-site.sh"
build_output_directory     = "dist/client"
deploy_script_path         = "packages/tools/scripts/deploy-static-site.sh"
deploy_mode                = "direct"

build_worker_instance_type           = "m6i.xlarge"
build_worker_instance_count          = 1
build_worker_root_volume_size_gb     = 100
build_worker_associate_public_ip_address = true
build_worker_allowed_ssh_cidrs       = []
build_worker_detailed_monitoring     = true

# Persistent workers are disabled by default. A reviewed approval reference is
# required before they can be created, and the GitHub monitor does not start
# them unless WEB_PIPELINE_WORKER_AUTOSTART_ENABLED=true is set deliberately.
enable_pipeline_build_workers        = false
pipeline_build_worker_approval_reference = ""

# Enable this once the target account has a GitHub Actions OIDC provider and
# you want the monitor workflow to start/stop the EC2 worker automatically.
enable_github_actions_worker_control = false
create_github_oidc_provider          = false

# Operations and spend protection. The email subscription must be confirmed
# once AWS sends its confirmation message to support@hashpass.tech.
ops_alert_email               = "support@hashpass.tech"
monthly_cost_budget_name      = "My Monthly Cost Budget"
monthly_cost_budget_usd       = 80
ec2_compute_monthly_budget_usd = 25
cost_anomaly_threshold_usd    = 5
# Reuse an existing AWS services anomaly monitor when the account already has one.
# cost_anomaly_monitor_arn = "arn:aws:ce::<account-id>:anomalymonitor/<monitor-id>"

# Production CloudFront for hashpass.tech. Request/validate the ACM certificate
# in us-east-1, then paste the issued ARN here before enabling the cutover.
site_route53_zone_name   = "hashpass.tech"
site_custom_domain_name  = "hashpass.tech"
site_acm_certificate_arn = ""

enable_cloudfront = true
dev_enable_cloudfront = false

# The development pipeline deploys from develop and stays separate from the
# production pipeline in the same Terraform state. The dev hostname now lives
# inside the parent hashpass.tech zone in the target account.
dev_branch_name = "develop"
dev_route53_zone_name = "hashpass.tech"
dev_custom_domain_name = "dev.hashpass.tech"

# Leave these unset unless you need fixed bucket names. Terraform will use
# unique generated names, and Route 53 can still alias to the S3 website
# endpoint of a bucket with any name.
# site_bucket_name     = ""
# dev_site_bucket_name = ""

# If CloudFront is unavailable in the target account, use literal A records for
# the S3 website endpoint instead of Route 53 alias records. Keep these empty
# when CloudFront is enabled.
# site_route53_a_records = []
# dev_route53_a_records = [
#   "3.5.88.53",
#   "3.5.88.112",
#   "3.5.133.254",
#   "3.5.130.101",
#   "52.219.179.88",
#   "3.5.132.48",
#   "52.219.98.72",
#   "3.5.93.118",
# ]

# Artifact buckets can keep the generated names unless you want to pin them.
# artifact_bucket_name     = "hashpass-production-pipelines-952191196420-us-east-2"
# dev_artifact_bucket_name = "hashpass-dev-pipelines-952191196420-us-east-2"

# Additional build environment variables if required by the app bundle.
build_environment_overrides = {
  EXPO_PUBLIC_NATIVE_GOOGLE_SIGNIN = "false"
}

tags = {
  Project = "hashpass"
  Owner   = "platform"
}
