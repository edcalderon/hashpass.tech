{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@hashpass-tech/sdk": [
        "../sdk/dist/index.d.ts"
      ],
      "@hashpass-tech/sdk/auth": [
        "../sdk/dist/auth/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
