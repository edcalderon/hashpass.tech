{
  "name": "@hashpass/wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts"
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:db": "bash test/run-enrollment-db.sh",
    "test:coverage": "c8 --all --include=src/**/*.ts --reporter=lcov --reporter=text --reports-dir=coverage node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "@scure/btc-signer": "2.4.1",
    "ethers": "6.15.0",
    "micro-key-producer": "0.10.2"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "c8": "^10.1.3",
    "fake-indexeddb": "6.2.5",
    "tsx": "^4.20.6",
    "typescript": "~5.8.3"
  }
}
