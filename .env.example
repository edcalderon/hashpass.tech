EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=
EAS_PROJECT_ID=
EXPO_TOKEN=
EAS_PROJECT_ID_DEV=
EXPO_TOKEN_DEV=

# Database-first public event ingestion. These are server/CI-only; never expose
# the service-role key through an EXPO_PUBLIC_* variable.
EVENT_INGESTION_SUPABASE_URL=
EVENT_INGESTION_SUPABASE_SERVICE_ROLE_KEY=
# Explicitly enable only while migrating or for disaster recovery.
EVENT_INGESTION_LEGACY_JSON_FALLBACK=false

# Claude creative briefs for the offline Diffusion Studio event-video workflow.
# Server/CLI only: never prefix these with EXPO_PUBLIC_ or commit a real key.
# Use a short-lived local service-account key while developing; production will
# move to workload identity federation before any automated batch execution.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Event hero videos are rendered locally, then published only with the
# explicit `event-heroes:publish -- --publish` command. These values belong
# in an ignored local environment; do not expose them to Expo/browser code.
EVENT_MEDIA_BUCKET=
EVENT_MEDIA_REGION=us-east-2
EVENT_MEDIA_PUBLIC_BASE_URL=

# Target AWS account used by the hashpass web/API Terraform stacks.
# Configure a local AWS CLI profile named "hashpass" from these values; never commit .env.
AWS_TARGET_ACCOUNT_ID=
AWS_TARGET_ACCESS_KEY=
AWS_TARGET_SECRET_KEY=
